# Copy to .env.local for local dev. On Vercel set it in Project > Settings > Environment Variables.
# URL of mafia-backend. Unset = localhost:4000 in dev, https://mafia-backend-z04f.onrender.com in production builds
NEXT_PUBLIC_SERVER_URL=http://localhost:4000
# Discord invite for the "Join our Discord" buttons (menu, home, voice panel, game over).
# Default: the team server https://discord.gg/SCaPFuzkGp (never expires). Set only to use another invite;
# must be https://discord.gg/<code> or https://discord.com/invite/<code>.
NEXT_PUBLIC_DISCORD_URL=
